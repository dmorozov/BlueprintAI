# Copy to .env.local (gitignored) and fill in your key, then restart the dev server.
# Get a key at https://aistudio.google.com/apikey
# NOTE: EXPO_PUBLIC_* values are inlined into the client bundle — prototype only.
# Before real deployment, move the AI call behind a small backend proxy.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: force the AI provider — "gemini" (real API; requires the key above) or
# "mock" (local sample plan, no network, no key). Default: gemini when a key is set,
# mock otherwise, so the full capture → analyze → render flow works out of the box.
# EXPO_PUBLIC_AI_PROVIDER=mock
